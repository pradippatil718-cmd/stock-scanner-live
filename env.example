# Copy these into your hosting platform's "Environment Variables" screen.
# NEVER put these values inside the frontend HTML/JS file or commit them to a public repo.

# From https://upstox.com/developer -> your app -> API Key
UPSTOX_API_KEY=paste_your_api_key_here

# From https://upstox.com/developer -> your app -> API Secret
UPSTOX_API_SECRET=paste_your_api_secret_here

# Must exactly match the Redirect URI you typed when creating the Upstox app.
# Format: https://YOUR-APP-NAME.onrender.com/api/auth/callback
UPSTOX_REDIRECT_URI=https://your-app-name.onrender.com/api/auth/callback
